<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The macOS stand-in for the crontab entry: runs ram-altman.sh every five
    minutes for the logged-in user. Fill in the script path and the addresses,
    copy this file to ~/Library/LaunchAgents/, then load it with:

        launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/lol.ram-altman.plist

    and stop it again with:

        launchctl bootout gui/$(id -u)/lol.ram-altman
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>lol.ram-altman</string>

    <!-- launchd expands neither ~ nor $HOME, so this has to be a full path. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/ram-altman.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RAM_ALTMAN_TO</key>
        <string>recipient@example.com</string>
        <key>RAM_ALTMAN_FROM</key>
        <string>you@example.com</string>
        <key>RAM_ALTMAN_FROM_NAME</key>
        <string>Your Name</string>
    </dict>

    <!-- Every five minutes. launchd never starts a second copy while one is running. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <!-- cron would have mailed you any errors. launchd puts them here instead. -->
    <key>StandardErrorPath</key>
    <string>/tmp/ram-altman.err</string>
</dict>
</plist>
